# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

# URL dasar API (tanpa /api/transaction)
API_BASE_URL=https://markaz.cerehub.id

# API key dari tim backend (wajib; tanpa ini dashboard berjalan dalam mode demo)
API_KEY=

# Opsional: cara mengirim API key. Biarkan kosong agar server mendeteksi otomatis
# (x-api-key, Authorization: Bearer, api-key, Authorization, ?api_key=, ?key=).
# API_KEY_HEADER=x-api-key
# API_KEY_QUERY=api_key

DEFAULT_PLATFORM=jadiasn
PORT=3000
# DEMO=1 untuk memaksa data contoh
