# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

# URL dasar API (tanpa /api/transaction)
API_BASE_URL=https://markaz.cerehub.id

# API key dari tim backend (wajib; tanpa ini dashboard berjalan dalam mode demo)
API_KEY=

# Opsional: default-nya key dikirim di header "Authorization: <key>" (format API Markaz).
# API_KEY_HEADER=Authorization

DEFAULT_PLATFORM=all
PORT=3000
# DEMO=1 untuk memaksa data contoh

# Password dashboard (login browser). Wajib di Vercel; opsional di komputer lokal.
# DASHBOARD_USER=sales
# DASHBOARD_PASSWORD=

# ---------- Agent Tele ----------
# Token bot dari @BotFather
# TELEGRAM_BOT_TOKEN=
# API key Anthropic untuk Claude (penulis pesan). Tanpa ini pesan memakai template sederhana.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Di Vercel: BLOB_READ_WRITE_TOKEN (otomatis dari Blob store) dan CRON_SECRET (pengaman jadwal)
