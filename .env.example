# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

# URL dasar API (tanpa /api/transaction), contoh: https://api.domainanda.com
API_BASE_URL=

# API key dari tim backend
API_KEY=

# Nama header pengirim API key (default x-api-key). Contoh lain: Authorization
API_KEY_HEADER=x-api-key
# Jika API key dikirim lewat query string, isi nama parameternya (mis. api_key). Kosongkan jika lewat header.
API_KEY_QUERY=

DEFAULT_PLATFORM=jadiasn
PORT=3000
# DEMO=1 untuk memaksa data contoh
